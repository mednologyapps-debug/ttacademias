# Hostinger MySQL: create the database and user in hPanel, then use its exact values.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Generate with: openssl rand -base64 48
AUTH_SECRET=
APP_URL=https://ttacademias.com
BASE_DOMAIN=ttacademias.com

# Email (SMTP) for verification, password reset, and notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TT Academias <no-reply@ttacademias.com>"

# Google OAuth; register callback: https://ttacademias.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment gateway credentials are added after selecting the provider.
